# The API image builds from the repository root so it can carry shared/ and
# theme/ alongside api/. Without this file that context is ~470MB of storefront
# source, generated artwork and node_modules, none of which the API runs.
.git
**/node_modules

# Storefront build output and bulk source. Keep site/src/content — the theme
# renderer imports journal posts from there at boot.
site/dist
site/public
site/scripts
site/src/components
site/src/lib
site/src/pages
site/src/styles
site/index.html
site/package.json
site/package-lock.json
site/tsconfig.json
site/tsconfig.*.json
site/vite.config.*
site/*.config.*

# Source artwork and every generated render.
assets

# Local scratch and docs.
seo
docs
*.md
.claude
.vscode

# On the server the build context is /opt/otrace, which also holds the built
# storefront that the web container serves from a bind mount. The API image
# never needs it.
web
deploy
.env