# Copy to /opt/otrace/.env on the server and fill in. Never commit real values.
SITE_URL=https://otrace.co

DB_NAME=otrace
DB_USER=otrace
DB_PASSWORD=<generate on the server>
DB_ROOT_PASSWORD=<generate on the server>

# From the Stripe dashboard. Live keys only once you are ready to take money.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Mailbox that sends order confirmations.
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
SHOP_EMAIL=

# IndexNow runs on API boot. Set to 0 to skip that ping.
# INDEXNOW_SUBMIT=0
