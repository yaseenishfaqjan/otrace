# Copy to /opt/otrace/.env on the server and fill in. Never commit real values.
SITE_URL=https://otrace.co

DB_NAME=otrace
DB_USER=otrace
DB_PASSWORD=<generate on the server>
DB_ROOT_PASSWORD=<generate on the server>

# From the Stripe dashboard. Live keys only once you are ready to take money.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Mailbox that sends order confirmations.
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
SHOP_EMAIL=

# IndexNow runs on API boot. Set to 0 to skip that ping.
# INDEXNOW_SUBMIT=0

# Klaviyo private key (pk_...) and the list id. Leave both blank to keep leads
# in MySQL only. The API logs: ESP sync skipped.
KLAVIYO_PRIVATE_API_KEY=
KLAVIYO_LIST_ID=

# Storefront build args. Vite inlines these into the browser bundle.
# Rebuild the site after setting them. Leave blank to hide the control.
# WhatsApp is E.164 digits with no plus. PUBLIC_WHATSAPP_NUMBER is an alias.
# VITE_INSTAGRAM_URL is an alias of VITE_INSTAGRAM. Do not invent a profile.
VITE_WHATSAPP_NUMBER=
# PUBLIC_WHATSAPP_NUMBER=
VITE_INSTAGRAM=
# VITE_INSTAGRAM_URL=
VITE_TIKTOK=
VITE_PINTEREST=
