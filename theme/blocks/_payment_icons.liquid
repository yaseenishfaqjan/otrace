<div class="hdt-payments-wrap">
  {%- assign arr = block.settings.svg | remove: ' ' | split: "," -%}
  <div class="hdt-pr hdt-row-flex" style="--height-img:{{ block.settings.height }}px; gap:10px;">
    {%- for img in arr -%}
      {%- if img contains 'cust4__' -%}
        {%- assign getIMG = img | remove_first: "cust4__" -%}
        {%- assign image = images[getIMG] -%}
        {%- if image == blank %}{% continue %}{% endif -%}
        {%- comment -%}
          The lazyload stand-in here was a generic icon on cdn.shopify.com.
          Nothing else on this store loads from Shopify and the real image is
          local, so the placeholder was the only external request in the block.
        {%- endcomment -%}
        <img loading="lazy" src="{{ image | image_url: width: 100 }}" width="{{ image.width }}" height="{{ image.height }}" alt="{{ image.alt | escape }}" />
      {%- else -%}
        <img loading="lazy" class="lazyloadhdt" src="/brand/payment/{{ img }}.svg" width="{{ img.width }}" height="{{ img.height }}"  alt="{{ img | replace: '_', ' ' }}" />
      {%- endif -%}
    {%- endfor -%}
  </div>
</div>
<style>
.hdt-payments-wrap img{
  height:var(--height-img);
}
</style>
{% schema %}
  {
    "name": "t:blocks.payment.name",
    "class": "hdt-payment-icons",
    "settings": [
      {
        "type": "textarea",
        "id": "svg",
        "label": "t:blocks.payment.settings.svg",
        "default": "visa,master,american_express,discover,diners_club,jcb",
        "info": "visa,master,american_express,discover,diners_club,jcb",
      },
      {
        "type": "paragraph",
        "content": "t:blocks.payment.settings.svg_library"
      },
      {
        "type": "number",
        "id": "height",
        "label": "t:blocks.payment.settings.height",
        "default": 30
      }
    ],
    "presets":[
      {
        "name":"t:blocks.payment.name"
      }
    ]
  }
{% endschema %}
